      "assertion": "result.price_cents == @prod.price_cents",
      "rationale": "The requirement mandates storing price as integer cents to avoid floating-point errors; the test verifies that the retrieved product's price_cents field is stored and returned as an integer value, matching the input.",
      "semantic": "fully"
    },
    {
      "requirement_id": "11",
      "setup": [
        {
          "entity": "Category",
